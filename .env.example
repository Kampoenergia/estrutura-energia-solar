# Copie para .env. Nunca envie uma senha real ao GitHub.
NODE_ENV=development
PORT=3000
PANEL_SENHA=troque-por-uma-senha-unica-e-longa
DATA_DIR=./data
TRUST_PROXY=0
PREVIEW_MODE=0
# No Render existente: NODE_ENV=production e TRUST_PROXY=1.
# DATABASE_URL deve ser preenchida diretamente na hospedagem, não no GitHub ou no chat.
# Sem DATABASE_URL, o servidor se recusa a iniciar em produção.
DATABASE_URL=
# SITE_URL=https://seu-dominio.com.br

# Tráfego pago: habilitar apenas após conferir domínio e identificadores.
ADS_TRACKING_ENABLED=false
META_PIXEL_ID=1425129716157804
# Google Ads: conversão existente, informada pelo usuário. Não recriar.
GOOGLE_ADS_ID=AW-17289607771
GOOGLE_ADS_LEAD_LABEL=SJlgCKvclvAcENv0qbRA
# Opcional: ação de conversão SEPARADA e secundária para cliques no WhatsApp.
GOOGLE_ADS_WHATSAPP_LABEL=
